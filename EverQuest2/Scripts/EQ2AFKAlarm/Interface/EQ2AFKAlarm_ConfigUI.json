            "padding":12,
            "_dock":"right",
            "eventHandlers":{
              "onMouseButtonMove":{
                "type":"forward",
                "elementType":"window",
                "event":"onCloseButtonClick"
              }
            }
          },
          {
            "type":"button",
            "borderThickness":2,
            "content":"🗕",
            "font":{
              "face":"Segoe UI",
              "height":40
